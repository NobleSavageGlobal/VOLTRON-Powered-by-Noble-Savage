# Root environment variables for docker-compose

# Database
POSTGRES_DB=bba_db
POSTGRES_USER=bba
POSTGRES_PASSWORD=change-me-in-production

# Backend
SECRET_KEY=change-me-to-a-secure-random-string-at-least-32-chars
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql+asyncpg://bba:change-me-in-production@postgres:5432/bba_db
REDIS_URL=redis://redis:6379/0

# AI
OPENAI_API_KEY=

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=bba-command-os

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
