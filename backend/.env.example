# ─── Database ───────────────────────────────────────────────────────────────
# SQLite (development — no Postgres needed)
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# PostgreSQL (production)
# DATABASE_URL=postgresql+asyncpg://bba:password@localhost:5432/bba_db

# ─── Redis (optional — used for caching/queuing) ────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Security ───────────────────────────────────────────────────────────────
# Generate a strong key: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-secure-random-string-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── CORS ───────────────────────────────────────────────────────────────────
# Must be a JSON array (not comma-separated)
CORS_ORIGINS=["http://localhost:3000"]

# ─── AI (optional) ──────────────────────────────────────────────────────────
# Leave blank to skip AI document analysis (documents still upload and classify)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ─── File Storage ───────────────────────────────────────────────────────────
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_MB=50

# AWS S3 (only needed if STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=bba-command-os

# ─── App ────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
